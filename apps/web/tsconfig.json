{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "types": ["bun", "vite/client", "vitest/globals"]
  },
  "include": ["src", "tests", "drizzle.config.ts", "vite.config.ts"]
}
