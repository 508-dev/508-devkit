{
  "name": "508-devkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "pnpm -C apps/web run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -C apps/web run typecheck",
    "test": "pnpm -r run test",
    "check": "./scripts/check-all.sh",
    "ports": "python3 scripts/worktree-ports.py env",
    "db:generate": "pnpm -C apps/web run db:generate",
    "db:push": "pnpm -C apps/web run db:push",
    "db:studio": "pnpm -C apps/web run db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^22.15.29",
    "typescript": "^5.9.3"
  }
}
