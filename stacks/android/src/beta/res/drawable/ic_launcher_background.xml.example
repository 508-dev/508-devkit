<?xml version="1.0" encoding="utf-8"?>
<!-- Beta-only launcher background colour. Copy to
     app/src/beta/res/drawable/ic_launcher_background.xml (drop the .example
     suffix) and pick a colour that clearly reads as "not production". The
     adaptive icon in the base source set already references
     @drawable/ic_launcher_background, so overriding this drawable in src/beta/
     recolours the launcher for beta builds only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#E65100"
        android:pathData="M0,0h108v108h-108z" />
</vector>
